{
  "name": "@nexus/desktop",
  "private": true,
  "version": "0.2.0-alpha.8",
  "description": "Versão de teste do ERP Nexus Construção e Reformas.",
  "author": {
    "name": "Nexus Construção e Reformas",
    "email": "nexus-teste@local.invalid"
  },
  "homepage": "https://nexusconstrucao.com",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -s first \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env NEXUS_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test:database": "node --test electron/database/store.test.cjs",
    "dist:test": "pnpm run build && electron-builder --linux AppImage deb --x64 --publish never",
    "dist:linux": "pnpm run build && electron-builder --linux AppImage deb --x64 --publish never",
    "dist:win": "pnpm run build && electron-builder --win nsis --x64 --publish never",
    "dist:mac": "pnpm run build && electron-builder --mac dmg zip --x64 --arm64 --publish never",
    "release:alpha": "pnpm run build && electron-builder --linux AppImage deb --x64 --publish always"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "electron-updater": "^6.8.11",
    "jspdf": "^4.2.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "^8.3.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.2.3",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.2",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.nexus.construcao.reformas.teste",
    "productName": "Nexus Teste",
    "executableName": "Nexus-Teste",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "artifactName": "Nexus-Teste-${version}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "gustavo3233",
        "repo": "nexus-updates",
        "channel": "alpha",
        "releaseType": "prerelease"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "synopsis": "ERP Nexus — versão de teste",
      "maintainer": "Nexus Construção e Reformas"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.business"
    }
  }
}
